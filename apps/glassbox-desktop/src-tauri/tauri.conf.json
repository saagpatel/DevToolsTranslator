{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glassbox",
  "version": "0.1.0",
  "identifier": "com.glassbox.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../../glassbox-ui build",
    "frontendDist": "../../glassbox-ui/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Glassbox",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["PrivacyInfo.xcprivacy"],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
