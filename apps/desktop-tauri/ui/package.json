{
  "name": "@dtt/desktop-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop UI React app",
  "type": "module",
  "scripts": {
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck && vitest run",
    "build": "pnpm run typecheck && vite build --outDir .vite-dist",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --outDir .vite-dist",
    "dev": "vite"
  },
  "dependencies": {
    "@dtt/shared-types": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
